DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/garage_app?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=5000
CLIENT_URL="http://localhost:3000"

# Optional. When both are set, password-reset emails are marked as email delivery.
# Without them, the API returns a one-hour reset link for local use.
SMTP_HOST=
SMTP_USER=
